{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "A Discord bot built with TypeScript and discord.js",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "lint": "eslint src/**/*.ts",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@types/ms": "^0.7.34",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.5.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  }
}